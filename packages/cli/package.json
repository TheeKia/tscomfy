{
  "name": "@tscomfy/cli",
  "version": "0.0.0",
  "description": "Command-line interface for tscomfy: generate types from a ComfyUI server and check them for drift.",
  "license": "MIT",
  "bin": {
    "tscomfy": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@tscomfy/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@tscomfy/codegen": "workspace:*",
    "@tscomfy/core": "workspace:*"
  },
  "devDependencies": {
    "@tscomfy/fixtures": "workspace:*"
  }
}
