{
  "name": "@tscomfy/layout",
  "version": "0.0.0",
  "description": "Automatic layout for tscomfy workflows written in the ComfyUI frontend's UI format.",
  "keywords": [
    "comfyui",
    "graph",
    "layout",
    "typescript",
    "workflow"
  ],
  "homepage": "https://github.com/TheeKia/tscomfy/tree/main/packages/layout#readme",
  "bugs": "https://github.com/TheeKia/tscomfy/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheeKia/tscomfy.git",
    "directory": "packages/layout"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@tscomfy/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@tscomfy/core": "workspace:*",
    "@tscomfy/fixtures": "workspace:*"
  },
  "peerDependencies": {
    "@tscomfy/core": "workspace:^"
  },
  "engines": {
    "bun": ">=1.4",
    "node": ">=24"
  }
}
