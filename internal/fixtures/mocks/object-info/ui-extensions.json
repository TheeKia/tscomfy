    "name": "CameraAngle",
    "display_name": "Compose Camera Angle Prompt",
    "description": "",
    "python_module": "comfy_extras.nodes_camera_angle",
    "category": "3d",
    "output_node": false
  },
  "CreateCameraInfo": {
    "input": {
      "required": {
        "mode": [
          "COMFY_DYNAMICCOMBO_V3",
          {
            "options": [
              {
                "key": "orbit",
                "inputs": {
                  "required": {
                    "yaw": [
                      "FLOAT",
                      {
                        "default": 35,
                        "min": -360,
                        "max": 360,
                        "step": 1
                      }
                    ],
                    "pitch": [
                      "FLOAT",
                      {
                        "default": 30,
                        "min": -89,
                        "max": 89,
                        "step": 1
                      }
                    ],
                    "distance": [
                      "FLOAT",
                      {
                        "default": 4,
                        "min": 0.01,
                        "max": 1000,
                        "step": 0.01
                      }
                    ]
                  }
                }
              },
              {
                "key": "look_at",
                "inputs": {
                  "required": {
                    "position_x": [
                      "FLOAT",
                      {
                        "default": 4,
                        "min": -1000,
                        "max": 1000,
                        "step": 0.01
                      }
                    ],
                    "position_y": [
                      "FLOAT",
                      {
                        "default": 4,
                        "min": -1000,
                        "max": 1000,
                        "step": 0.01
                      }
                    ],
                    "position_z": [
                      "FLOAT",
                      {
                        "default": 4,
                        "min": -1000,
                        "max": 1000,
                        "step": 0.01
                      }
                    ]
                  }
                }
              }
            ]
          }
        ],
        "target_x": [
          "FLOAT",
          {
            "default": 0,
            "min": -1000,
            "max": 1000,
            "step": 0.01
          }
        ],
        "target_y": [
          "FLOAT",
          {
            "default": 0,
            "min": -1000,
            "max": 1000,
            "step": 0.01
          }
        ],
        "target_z": [
          "FLOAT",
          {
            "default": 0,
            "min": -1000,
            "max": 1000,
            "step": 0.01
          }
        ],
        "roll": [
          "FLOAT",
          {
            "default": 0,
            "min": -180,
            "max": 180,
            "step": 1
          }
        ],
        "fov": [
          "FLOAT",
          {
            "default": 35,
            "min": 1,
            "max": 120,
            "step": 1
          }
        ],
        "zoom": [
          "FLOAT",
          {
            "default": 1,
            "min": 0.01,
            "max": 100,
            "step": 0.01
          }
        ],
        "camera_type": [
          "COMBO",
          {
            "multiselect": false,
            "options": ["perspective", "orthographic"]
          }
        ]
      },
      "optional": {
        "camera_info_state": [
          "CAMERA_INFO_STATE",
          {
            "socketless": true
          }
        ]
      }
    },
    "input_order": {
      "required": [
        "mode",
        "target_x",
        "target_y",
        "target_z",
        "roll",
        "fov",
        "zoom",
        "camera_type"
      ],
      "optional": ["camera_info_state"]
    },
    "output": ["LOAD3D_CAMERA"],
    "output_is_list": [false],
    "output_name": ["camera_info"],
    "name": "CreateCameraInfo",
    "display_name": "Create Camera Info",
    "description": "",
    "python_module": "comfy_extras.nodes_camera",
    "category": "3d",
    "output_node": false
  },
