  "CameraAngle": {
    "input": {
      "required": {
        "horizontal_angle": [
          "INT",
          {
            "default": 0,
            "min": 0,
            "max": 360
          }
        ],
        "vertical_angle": [
          "INT",
          {
            "default": 0,
            "min": -30,
            "max": 60
          }
        ],
        "zoom": [
          "FLOAT",
          {
            "default": 5,
            "min": 0,
            "max": 10,
            "step": 0.1
          }
        ]
      },
      "optional": {
        "image": ["IMAGE", {}],
        "view": [
          "STRING",
          {
            "widgetType": "CAMERA_ANGLE_VIEW",
            "default": "",
            "socketless": true,
            "multiline": false
          }
        ]
      }
    },
    "input_order": {
      "required": ["horizontal_angle", "vertical_angle", "zoom"],
      "optional": ["image", "view"]
    },
    "output": ["LOAD3D_CAMERA", "STRING"],
    "output_is_list": [false, false],
