  "MockWidgetTypeOverrides": {
    "input": {
      "required": {
        "rate": [
          "FLOAT,INT",
          { "default": 24, "widgetType": "FLOAT", "min": 1, "max": 240, "step": 0.01 }
        ],
        "file": ["STRING,MOCK_FILE", { "default": "", "widgetType": "STRING" }],
        "sketch": [
          "STRING",
          { "default": "", "widgetType": "PAINTER", "socketless": true, "multiline": false }
        ],
        "timestamp": ["STRING", { "default": "00:00", "widgetType": "MOCK_PACK_TIMESTAMP" }],
        "custom": ["MOCK_PACK_STATE", { "default": "{}", "socketless": true }],
        "picker": [
          "COMBO",
          { "widgetType": "MOCK_PACK_PICKER", "options": ["a", "b"], "default": "a" }
        ],
        "size": ["MOCK_SIZE", { "widgetType": "COMBO", "options": ["s", "m"], "default": "s" }],
        "count": ["INT", { "widgetType": "COMBO", "options": [1, 2], "default": 1 }]
      }
    },
    "input_order": {
      "required": ["rate", "file", "sketch", "timestamp", "custom", "picker", "size", "count"]
