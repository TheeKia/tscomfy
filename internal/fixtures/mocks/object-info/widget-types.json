    "output_is_list": [false],
    "output_name": ["FLOAT"],
    "name": "MockWidgetTypeOverrides",
    "display_name": "Mock Widget Type Overrides",
    "description": "widgetType picks the frontend widget: a FLOAT widget on a FLOAT,INT socket, a STRING widget on a union, a value widget on a STRING, and a widget only a pack's browser code registers; a COMBO type with a pack widget, a COMBO widget on a pack type and on INT. A pack type with a default but no widget stays a socket.",
    "python_module": "custom_nodes.mock-pack",
