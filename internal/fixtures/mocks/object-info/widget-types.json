            "forceInput": true
          }
        ],
        "preview": ["RESOLUTION_PREVIEW", { "socketless": true, "tooltip": "Display only." }]
      }
    },
    "input_order": {
      "required": ["color", "region", "palette", "compare"],
      "optional": ["curve", "preview"]
    },
