    "output_name": ["IMAGE"],
    "output_tooltips": [null],
    "output_matchtypes": null,
    "name": "MockValueWidgets",
    "display_name": "Mock Value Widgets",
    "description": "Core frontend widgets whose values are arbitrary JSON: object and list defaults, no default, forceInput, and a display-only widget the frontend never sends.",
    "python_module": "comfy_extras.nodes_mock",
    "category": "mock/widgets",
    "output_node": false,
