{
  "1": {
    "inputs": { "image": "example.png" },
    "class_type": "LoadImage",
    "_meta": { "title": "Load Image" }
  },
  "2": {
    "inputs": {
      "crop_region": { "x": 8, "y": 16, "width": 256, "height": 128 },
      "image": ["1", 0]
    },
    "class_type": "ImageCropV2",
    "_meta": { "title": "Crop Image" }
  },
  "3": {
    "inputs": { "horizontal_angle": 30, "vertical_angle": 15, "zoom": 4.5, "image": ["2", 0] },
    "class_type": "CameraAngle",
    "_meta": { "title": "Compose Camera Angle Prompt" }
  },
  "4": {
    "inputs": {
      "mode": "look_at",
      "mode.position_x": 1,
      "mode.position_y": 2,
      "mode.position_z": 3,
      "target_x": 0.5,
      "target_y": 0,
      "target_z": 0,
      "roll": 10,
      "fov": 50,
      "zoom": 2,
      "camera_type": "orthographic"
    },
    "class_type": "CreateCameraInfo",
    "_meta": { "title": "Create Camera Info" }
  },
  "5": {
    "inputs": {
      "model_file": "none",
      "upload 3d model": "upload3dmodel",
      "upload extra resources": "uploadExtraResources",
      "clear": "clear",
      "image": {
        "image": "threed/undefined [temp]",
        "mask": "threed/undefined [temp]",
        "normal": "threed/undefined [temp]",
